@startuml direct-rialto-data-path-class
title direct-rialto media sources and handshake types
skinparam shadowing false

class AampRialtoPlayer {
  m_sources[3] : SourcePtr
  m_segmentPosition
  m_audioInVideoSlot : atomic<bool>
  getSource(track)
  SendSample() / SendCopy() / SendTransfer()
}

abstract class AampRialtoMediaSource {
  m_handshake
  m_sourceId, m_mksId : atomic<int32>
  m_pendingCodecData
  m_firstPtsMs, m_acceptedFrames ...
  attachOrUpdate()
  injectOneSample()
  handleNeedData()
  signalEos()
  unblockInjection()
  gateInjection()
  {abstract} mapCodecToMime()
  {abstract} createRialtoSource()
  {abstract} createSegment()
}

class AampRialtoVideoSource
class AampRialtoAudioSource
class AampRialtoSubtitleSource

class AampRialtoNeedDataHandshake {
  OnNeedData() / OnCancelNeedData()
  BeginInject() / WaitForGate()
  WaitForRequest() / WaitForAttach()
  OnNoSpace() / DropSample() / Complete()
  Unblock() / SetGate() / SignalEos() / Reset()
}

class "State (guarded by mu)" as State {
  hasPending, pendingRequestId
  pendingFrameCount, segmentsAddedInBatch
  batch* statistics
  eos, generation
  gateMode, injectorActive, attachPending
}

enum GateMode {
  NONE
  BLOCKED
  DROPPED
}

class Claim {
  requestId
  batch : BatchSummary
}

class NeedDataResult {
  superseded : optional<Claim>
  rejected : bool
  eos : optional<Claim>
}

class WaitResult {
  outcome : Wait
  requestId
  abandoned : optional<Claim>
}

class DropResult {
  claim : optional<Claim>
  eos : bool
}

class Completion {
  reply : Reply
  batch : BatchSummary
}

enum "Wait" as Wait {
  Proceed
  GateReasserted
  Abort
}

enum "Reply" as Reply {
  None
  Ok
  Eos
  Abandoned
}

enum "AttachWait" as AttachWait {
  NotPending
  Attached
  Aborted
}

AampRialtoPlayer o-- "0..3" AampRialtoMediaSource
AampRialtoMediaSource <|-- AampRialtoVideoSource
AampRialtoMediaSource <|-- AampRialtoAudioSource
AampRialtoMediaSource <|-- AampRialtoSubtitleSource
AampRialtoMediaSource *-- AampRialtoNeedDataHandshake
AampRialtoNeedDataHandshake *-- State
State --> GateMode
AampRialtoNeedDataHandshake ..> NeedDataResult
AampRialtoNeedDataHandshake ..> WaitResult
AampRialtoNeedDataHandshake ..> DropResult
AampRialtoNeedDataHandshake ..> Completion
AampRialtoNeedDataHandshake ..> AttachWait
WaitResult --> Wait
Completion --> Reply
NeedDataResult --> Claim
WaitResult --> Claim
DropResult --> Claim

note bottom of Claim
  Every operation that closes a request returns a Claim
  (with BatchSummary) and clears hasPending under the lock.
  The caller sends haveData() afterwards, lock released.
end note
@enduml
