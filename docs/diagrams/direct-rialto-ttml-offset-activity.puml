@startuml direct-rialto-ttml-offset-activity
title AampRialtoTtmlOffset::Refine(document, ptsMs, durationMs, aampOffsetMs)

start
if (mode == PASSTHROUGH?) then (yes)
  :return 0;
  stop
endif
:take the first XML document only\n(Harmonic UHD buffers concatenate several);
if (first begin="hh:mm:ss[.fff]" found and valid?) then (no)
  :empty or header-only document;
  :return LINEAR_OFFSET ? stored offset : 0;
  stop
endif
:offsetFromPts = firstBeginMs - ptsMs;
if (mode == UNKNOWN?) then (yes)
  if (|offsetFromPts - aampOffsetMs| > durationMs?) then (yes)
    :mode = LINEAR_OFFSET\noffset = offsetFromPts\n(cue times are absolute / wall clock);
  elseif (aampOffsetMs != 0?) then (yes)
    :mode = LINEAR_OFFSET\noffset = aampOffsetMs\n(AAMP knows the period offset);
  else (no)
    :mode = PASSTHROUGH\n(cue times match container PTS);
    :return 0;
    stop
  endif
else (LINEAR_OFFSET)
  :offset = |offsetFromPts - aampOffsetMs| > durationMs\n? offsetFromPts : aampOffsetMs\n(refined on every document);
endif
:return offset;
note right
  The result is set as the segment's display
  offset (ms); the Rialto server shifts cue
  times by it.  The mode is reset only by
  processInitFragment() (SUB-01).
end note
stop
@enduml
