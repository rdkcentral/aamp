@startuml direct-rialto-lifecycle-stop-sequence
title Stop(keepLastFrame): StopInternal(preservePendingPosition=false)

participant "AAMP control\nthread" as CT
participant "AampRialtoPlayer" as P
participant "Timers and\nmonitors" as T
participant "Sources /\nhandshakes" as SRC
participant "PipelineSession" as S
participant "Rialto" as R
participant "PlaybackController" as PC
participant "PlayerStateMachine" as SM

CT -> P : Stop()
activate P
P -> P : lock m_flushCallMutex
P -> SM : waitForFlushComplete(5000 ms)
P -> T : progress timer stop(),\npre-roll Stop(), SetMonitorAV(nullptr)
note right of T : each waits for a\nrunning tick
P -> SRC : unblockInjection("Stop", eos=false)
note right of SRC : generation++, gate DROPPED:\nblocked injectors return
P -> R : pipeline->stop()
P -> S : SetPipeline(nullptr)
P -> S : ReleaseControlBackend()
S -> R : IControl deregister
P -> PC : Reset("Stop")
note right of PC : drops play request and\nFlushing/PositionPending;\nkeeps SourcesNotAttached
P -> P : ClearForNewSession(),\nreset PTS tracking
P -> SM : onStop() -> IDLE
P --> CT : return
deactivate P
note over P, SM
  Not done by Stop(): destroying sources or the client, clearing the
  client's event sink.  keepLastFrame is unused (LIFE-06).
end note
@enduml
