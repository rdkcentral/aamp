@startuml direct-rialto-subtitle-dataflow-sequence
title Subtitle and CC data flow (three source forms)

participant "AAMP core\n(collector / injector)" as A
participant "AampMp4Demuxer" as D
participant "AampRialtoPlayer" as P
participant "AampRialtoSubtitleSource" as S
participant "Rialto pipeline" as R
participant "PlayerDirectRialto\nCCManager" as CC

== Configure(): create the subtitle source ==
A -> P : Configure(video, audio, subFormat)
alt subFormat TTML, MP4 or WebVTT (sidecar)
  P -> S : create, setFormat(subFormat), gate
  P -> P : AttachSource(synthesised TTML/VTT codec)\n(deferred until video is attached)
else no sidecar, video present: inband CC
  P -> S : create, setFormat(FORMAT_INVALID), gate
  P -> P : AttachSource(GST_FORMAT_UNKNOWN)
end
P -> R : attachSource(MediaSourceSubtitle(mime, "CC1"))\nmime = text/ttml | text/vtt | text/cc

== Raw TTML / WebVTT (no MP4 container) ==
A -> P : SendTransfer(SUBTITLE, buffer, pts, dur,\nfragmentPTSoffset)
P -> S : processDataFragment()
S -> S : displayOffset = +offset (TTML)\nor -offset (WebVTT)
S -> S : createSegment(): TTML -> AampRialtoTtmlOffset.Refine()
S -> R : addSegment(SUBTITLE, pts, dur,\nsetDisplayOffset) on needData

== TTML / WebVTT in MP4 (stpp / wvtt) ==
A -> D : subtitle fragments (playContext)
D -> P : SetStreamCaps(SUBTITLE, codecInfo)
P -> P : AttachSource; ResumeTrackDownloads(SUBTITLE)
D -> P : SendSample(SUBTITLE, sample with mDisplayOffsetMs)
P -> S : inject; createSegment() refines TTML offset
S -> R : addSegment(...)

== Inband CC ==
note over R : CC data stays inside the video stream;\nthe server's text-track sink decodes it
A -> P : first PLAYING -> NotifyFirstFrameReceived(GetCCHandle())
P -> CC : Initialize(IDirectRialtoCC*) via priv_aamp::InitializeCC
CC -> P : setTextTrackIdentifier("CC1" / "SERVICEn")
P -> R : setTextTrackIdentifier(id)
CC -> P : setCCMute(false / true)\n(StartRendering / StopRendering)
P -> R : setMute(subtitleSourceId, muted)
@enduml
