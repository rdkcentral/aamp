@startuml direct-rialto-timer-main-context-component
title direct-rialto timers and the default GLib main context

node "AAMP control thread" as CT
node "Rialto event thread\n(OnPlaybackState PLAYING)" as RT
node "Host app GLib main-loop thread\n(default GMainContext)" as ML

package "AampRialtoPlayer" {
	component "m_progressTimer\nAampRialtoProgressTimer" as PT
	component "m_monitorAV\nAampRialtoMonitorAV" as MAV
	component "m_preRollMonitor\nAampRialtoPreRollMonitor" as PRM
}

component "AampRialtoGlibTimer\n(State + Handle)" as GT
component "g_timeout_add_full(NULL context)" as GL
component "PrivateInstanceAAMPNotifiable" as NOT
component "AAMP scheduler thread\n(PrivateInstanceAAMP)" as SCH

RT --> PT : StartProgressTimer()\nstart or kick
RT --> MAV : start()
CT --> PT : StopProgressTimer()\n(Configure, Stop)
CT --> MAV : SetMonitorAV(nullptr)\n(Stop, Configure recreate)
CT --> PRM : Stop() (ArmPreRoll, Pause, Stop)

PT --> GT : 1 timer
MAV --> GT : sample + report timers
PRM --> GT : 10 ms poll timer
GT --> GL : schedule source
ML --> GL : iterates
GL --> GT : Dispatch() under State mutex

PT ..> NOT : MonitorProgress()
MAV ..> NOT : SendMonitorAvEvent()
NOT ..> SCH : ScheduleAsyncTask

note bottom of ML
  AAMP core does not run this loop.
  No loop = no progress, no MonitorAV,
  no pre-roll completion (ARCH-22).
end note
@enduml
