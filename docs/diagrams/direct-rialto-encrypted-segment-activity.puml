@startuml direct-rialto-encrypted-segment-activity
title Encrypted sample to Rialto segment (AampRialtoMediaSource::annotateEncryption)
skinparam shadowing false

start
if (sample.mDrmMetadata.mIsEncrypted?) then (no)
  :segment left clear\n(TRACE log if a DRM session exists);
  :return true;
  stop
endif
if (mksId < 0 (no DRM session)?) then (yes)
  :reject "no DRM session";
elseif (subsample table < numSubSamples x 6 bytes?) then (yes)
  :reject "sub-sample table shorter than declared";
else (ok)
  :setEncrypted(true);
  :setMediaKeySessionId(mksId);
  :setKeyId(keyId), setInitVector(IV);
  :setCipherMode(CENC / CBCS / CBC1 / CENS / UNKNOWN);
  if (cipher == CBCS?) then (yes)
    :setEncryptionPattern(cryptByteBlock, skipByteBlock);
  endif
  if (numSubSamples > 0?) then (yes)
    :for each 6-byte entry:\nclear = big-endian uint16, enc = big-endian uint32\naddSubSample(clear, enc);
  else (no)
    :addSubSample(0, sample size)\n(whole sample encrypted);
  endif
  :return true;
  stop
endif
:count drop; log ERR on the 1st and every 100th;
:return false -> injectOneSample() drops the sample\nand answers the request (never sends ciphertext\nwithout usable metadata);
stop
@enduml
