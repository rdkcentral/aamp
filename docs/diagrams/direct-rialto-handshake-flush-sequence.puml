@startuml direct-rialto-handshake-flush-sequence
title Handshake: Flush() while an injector is waiting
skinparam shadowing false

participant "Control thread\nFlush()" as CTL
participant "AampRialtoMediaSource" as SRC
participant "NeedDataHandshake" as HS
participant "Injector thread\n(in WaitForRequest)" as INJ
participant "IMediaPipeline" as PIPE
participant "Rialto event thread" as EV

CTL -> SRC : unblockInjection(pipeline, "Flush", newEos)
SRC -> HS : Unblock(newEos, previous)
note right of HS
  One critical section:
  generation++
  gateMode = DROPPED
  eos = newEos (if given)
end note
alt injectorActive == false
  HS --> SRC : Claim(pending request)
  SRC -> PIPE : haveData(NO_AVAILABLE_SAMPLES, req)
else injectorActive == true (injector owns the request)
  HS -> INJ : cv.notify_all()
  INJ -> HS : WaitForRequest sees generation != gen
  HS --> INJ : Abort + abandoned = Claim(req)
  INJ -> PIPE : haveData(NO_AVAILABLE_SAMPLES, req)
  note right of INJ
    injectOneSample() returns false.  processDataFragment
    stops the rest of the fragment; the sample is dropped.
  end note
end
CTL -> SRC : gateInjection(pipeline, true, "Flush")
SRC -> HS : SetGate(true): gateMode = BLOCKED
CTL -> PIPE : setPosition(posNs)
EV -> HS : OnNeedData(...) while BLOCKED
HS --> EV : rejected, answered NO_AVAILABLE_SAMPLES
...
EV -> EV : SEEK_DONE: HandleSeekDone() releases the Flushing hold
EV -> SRC : controller runs IssuePlay() -> UngateAllSources() -> gateInjection(false)
SRC -> HS : SetGate(false): gateMode = NONE
note over HS, INJ
  New samples (fresh capturedGen) pass the gate and wait for
  the next needData.  See the Flush/seek page for the full cycle.
end note
@enduml
