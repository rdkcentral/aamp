@startuml direct-rialto-threading-flush-sequence
title Flush wait/notify across threads (AampRialtoPlayer::Flush + SEEK_DONE)

participant "Control or\ninjector thread" as CT
participant "AampRialtoPlayer" as P
participant "PlaybackController\n(play lock)" as PC
participant "PlayerStateMachine\n(m_mutex, m_stateChanged)" as SM
participant "Sources /\nhandshakes" as SRC
participant "Rialto pipeline" as R
participant "Rialto event\nthread" as EV

CT -> P : Flush(pos, rate)
activate P
note right of P : take m_flushCallMutex
P -> SM : waitForFlushComplete(5000 ms)
note right of SM : returns at once unless a\nprevious flush is FLUSHING
P -> PC : AddHold(Flushing)
P -> P : StageRequested(pos, rate)
P -> PC : ReleaseHold(PositionPending)
P -> SM : currentState() flushable?
P -> SM : onFlush() -> FLUSHING
P -> SRC : unblockInjection + gate(BLOCKED)
note right of SRC : generation bump wakes\nblocked injectors; they abort
P -> R : setPosition(pos)
P --> CT : return (m_flushCallMutex released)
deactivate P

CT -> P : next Flush() / Configure() / Stop()
P -> SM : waitForFlushComplete()
activate SM
note right of SM : blocks while FLUSHING

R -> EV : SEEK_DONE
EV -> P : HandleSeekDone()
P -> SM : currentState() == FLUSHING?
P -> R : setSourcePosition (trickplay video,\nsubtitle under m_attachMutex)
P -> P : commit rate + baseline
P -> PC : ReleaseHold(Flushing)
note right of PC : while still FLUSHING, so a\nwaiting Flush cannot add a hold\nthat this release would drop
PC -> R : play() if a request is pending\nand no hold remains (event thread)
P -> SM : onFlushComplete() -> FLUSHED
SM --> CT : notify_all wakes waiter
deactivate SM

alt SEEK_DONE not received in 5000 ms
	SM -> SM : force FlushComplete (same mutex)
	SM -> P : onAbandoned: commit staged rate
	P -> PC : ReleaseHold(Flushing)
end
@enduml
