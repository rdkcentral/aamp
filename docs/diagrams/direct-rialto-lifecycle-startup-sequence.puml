@startuml direct-rialto-lifecycle-startup-sequence
title First tune: Configure() to first PLAYING

participant "AAMP control\nthread" as CT
participant "Injector\nthreads" as INJ
participant "AampRialtoPlayer" as P
participant "PlaybackController" as PC
participant "PipelineSession" as S
participant "Rialto client /\nserver" as R
participant "Rialto event\nthread" as EV

CT -> P : Configure(formats)
P -> P : WaitForFlushToComplete()\nArmPositionPending (gate sources)
P -> P : ShouldRecreatePipeline? yes (no pipeline)
P -> P : BeginNewSession()\nstate IDLE, AddHold(SourcesNotAttached),\nArmPreRoll
P -> S : CreateAndLoad()
S -> R : IControl::registerClient
S -> R : waitForRunning(2000 ms)
note right of S : WARN and proceed on\ntimeout (ARCH-18)
S -> R : createMediaPipeline(3840x2160)
S -> S : install player as event sink
S -> R : load(MSE, "mse://1")
P -> P : state PIPELINE_CREATED\napply cached volume, create AV monitor
P -> P : CreateSources() (each gated)
CT -> P : Stream()
P -> PC : RequestPlay("Stream")
note right of PC : holds remain:\nSourcesNotAttached, PositionPending

INJ -> P : SetStreamCaps(video)
P -> R : attachSource(video)
P -> P : SOURCES_ATTACHING; commit baseline,\nReleaseHold(PositionPending),\ndrain deferred audio/subtitle attaches
INJ -> P : SetStreamCaps(audio)
P -> R : attachSource(audio)
P -> R : allSourcesAttached()
P -> P : state SOURCES_ATTACHED
P -> PC : ReleaseHold(SourcesNotAttached)

alt pre-roll enabled (rate 1, GStreamerBufferingBeforePlay)
  PC -> P : StartPreRoll(): pause(), ungate,\nstart pre-roll monitor
  note right of P : monitor releases PreRollIncomplete\nafter frame floor / EOS / full / 1 s
  PC -> P : IssuePlay()
else no pre-roll
  PC -> P : IssuePlay()
end
P -> R : ungate sources, play()
R -> EV : needData ... (data path)
R -> EV : PLAYING
EV -> P : HandlePlaybackStarted()
P -> P : state PLAYING; first-frame and\ntune-complete notifications;\nstart progress timer, AV monitor
@enduml
