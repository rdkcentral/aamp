@startuml direct-rialto-timer-progress-tick-sequence
title Progress reporting: Rialto PLAYING to AAMP progress event

participant "Rialto event\nthread" as EV
participant "AampRialtoPlayer" as P
participant "AampRialtoProgressTimer /\nAampRialtoGlibTimer" as T
participant "GLib main loop\n(host application)" as GL
participant "PrivateInstanceAAMP\nNotifiable" as N
participant "AAMP scheduler\nthread" as SCH
participant "PrivateInstanceAAMP" as A
participant "Rialto pipeline" as R

EV -> P : HandlePlaybackStarted()
P -> N : first-frame notifications (async)
alt timer not running
  P -> N : GetProgressReportIntervalSeconds()
  P -> T : start(intervalMs, tick)
  T -> GL : g_timeout_add_full (default context)
  T -> P : FireNowIfRunning(): OnProgressTimerTick()\n(on the EVENT thread, under timer lock)
else timer running
  P -> T : kick(): RestartIfRunning + FireNowIfRunning
end
P -> N : MonitorProgress(sync=false)\n(from the immediate tick)
N -> SCH : ScheduleAsyncTask (no AAMP lock taken here)

loop every progressReportingInterval
  GL -> T : Dispatch
  T -> P : OnProgressTimerTick()
  P -> N : MonitorProgress(sync=false)
  N -> SCH : ScheduleAsyncTask
end

SCH -> A : MonitorProgress()
A -> P : GetPositionMilliseconds()
P -> R : getPosition() IPC
R --> P : position ns
P --> A : (position - segment start) x rate, or 0 while pending
A -> A : emit progress event to the application

note over P, T : Stop() -> StopProgressTimer() waits for a running tick;\nno tick starts afterwards (see the threading page).
@enduml
