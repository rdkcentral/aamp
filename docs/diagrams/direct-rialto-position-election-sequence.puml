@startuml direct-rialto-position-election-sequence
title Deferred position: which injector thread claims the flush
skinparam shadowing false

participant "Video injector" as VI
participant "Audio injector" as AI
participant "AampRialtoPlayer" as PLAYER
participant "AampRialtoSegmentPosition" as POS

note over PLAYER, POS
  Armed by Configure() / Discontinuity():
  ResetFlushClaim() + PositionPending hold added.
end note
par
  VI -> PLAYER : SendSample(VIDEO, first sample, pts)
  PLAYER -> PLAYER : MaybeFlushForPendingPosition(VIDEO, pts)
else
  AI -> PLAYER : SendSample(AUDIO, first sample, pts)
  PLAYER -> PLAYER : MaybeFlushForPendingPosition(AUDIO, pts)
  note right of PLAYER
    Elected track = VIDEO if a video source is attached,
    else AUDIO.  A non-elected track returns at once.
  end note
end
PLAYER -> PLAYER : lock m_flushCallMutex, re-check hold
PLAYER -> POS : ClaimDeferredFlush()
POS --> PLAYER : true (first caller only)
PLAYER -> PLAYER : Flush(pts, rate, shouldTearDown=false)
PLAYER -> PLAYER : Stream() (records intent; SEEK_DONE plays)
note over PLAYER, POS
  Skipped when: hold already released, state is FLUSHING (an
  earlier flush is in flight), or the claim was already taken.
end note
@enduml
