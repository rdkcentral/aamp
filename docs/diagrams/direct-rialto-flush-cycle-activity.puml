@startuml direct-rialto-flush-cycle-activity
title AampRialtoPlayer::Flush(position, rate, shouldTearDown, authoritative)

start
:lock m_flushCallMutex (recursive);
:WaitForFlushToComplete()\n(<= 5000 ms; abandon previous cycle on timeout);
:AddHold(Flushing)\n(waits for any running play() / pre-roll step);
:StageRequested(pos, rate, authoritative);
:ReleaseHold(PositionPending);
if (state is PLAYING, PAUSED,\nSOURCES_ATTACHED or FLUSHED?) then (flushable)
  :onFlush() -> FLUSHING;
  :ArmPreRoll(rate)\n(stop monitor; add or release PreRollIncomplete);
  :ResetSourcesForFlush(gate=true)\nunblockInjection (generation++, DROPPED, EOS for\naudio/subtitle if rate != 1) then gate BLOCKED;
  if (pipeline present?) then (yes)
    if (setPosition(pos) succeeds?) then (yes)
      :return; SEEK_DONE completes the\ncycle on the Rialto event thread;
      stop
    else (no)
      :WARN;
    endif
  endif
  :commit staged rate;\nonFlushComplete() -> FLUSHED;
  :ReleaseHold(Flushing);
  stop
else (not flushable)
  if (shouldTearDown?) then (yes)
    if (state IDLE and no pipeline?) then (yes)
      :log only (pre-Configure seek pre-stage);
    else (no)
      :FlushByTeardown:\nStopInternal(keepLastFrame=true,\npreservePendingPosition=true);
    endif
  else (no)
    :FlushWithoutCycle:\ncommit rate now;\nResetSourcesForFlush(gate=false);
  endif
  :ReleaseHold(Flushing);
  stop
endif
@enduml
