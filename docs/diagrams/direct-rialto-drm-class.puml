@startuml direct-rialto-drm-class
title direct-rialto: DRM classes (two separate hooks into AAMP's DRM stack)

package "direct-rialto/ - player side" {
	interface IDrmBridge {
		+createSession(systemId, initData, len, type) : mks_id
	}
	class AampDrmBridge {
		-m_aamp : PrivateInstanceAAMP* (non-owning)
	}
	class AampRialtoMediaSource
	class AampRialtoPlayer
}

package "AAMP core / middleware-player-interface" {
	class PrivateInstanceAAMP
	class AampDRMLicenseManager {
		+createDrmSession(...)
	}
	class DrmSessionManager {
		-m_sessionCreator : DrmSessionCreator
	}
	abstract class DrmSession {
		+getMediaKeySessionId()
	}
	class OCDMSessionAdapter <<DrmSessionFactory default>>
}

package "direct-rialto/ - session side" {
	class "makeRialtoSessionCreator()" as MK <<RialtoSessionCreator.cpp>>
	class RialtoMediaKeySessionAdapter {
		-m_system : unique_ptr<RialtoMediaKeySystem>
		-m_session : shared_ptr<RialtoMediaKeySession>
		+generateDRMSession()
		+generateKeyRequest()
		+processDRMKey()
	}
	class RialtoMediaKeySystem {
		-m_mediaKeys : unique_ptr<IMediaKeys>
		-m_client : shared_ptr<MediaKeysClient>
		+createSession(initDataType, initData, callbacks)
	}
	class "RialtoMediaKeySystem::MediaKeysClient" as MKC {
		callbacks, sessions, running (by keySessionId)
	}
	class RialtoMediaKeySession {
		-m_keyStatuses (mutex)
		+update() / close() / destruct()
		+isKeyUsable()
	}
	class RialtoSessionCallbacks <<struct>> {
		onChallenge / onKeyUpdate /
		onKeysUpdated / onLicenseRenewal
	}
}

interface "firebolt::rialto::IMediaKeys" as IMK <<Rialto>>
interface "firebolt::rialto::IMediaKeysClient" as IMKC <<Rialto>>

AampRialtoPlayer o-- IDrmBridge : shared_ptr
IDrmBridge <|.. AampDrmBridge
AampRialtoMediaSource ..> IDrmBridge : attachOrUpdate()\n(raw pointer, per call)
AampDrmBridge --> PrivateInstanceAAMP : mDRMLicenseManager,\nmMediaFormat
PrivateInstanceAAMP *-- AampDRMLicenseManager
AampDRMLicenseManager *-- DrmSessionManager
DrmSessionManager ..> DrmSession : creates
DrmSession <|-- OCDMSessionAdapter
DrmSession <|-- RialtoMediaKeySessionAdapter
PrivateInstanceAAMP ..> MK : ctor passes creator\nonly if useDirectRialto
MK ..> RialtoMediaKeySessionAdapter : builds
MK ..> RialtoMediaKeySystem : builds (one per session)
RialtoMediaKeySessionAdapter *-- RialtoMediaKeySystem
RialtoMediaKeySessionAdapter o-- RialtoMediaKeySession
RialtoMediaKeySystem *-- MKC
MKC ..|> IMKC
RialtoMediaKeySystem *-- IMK
RialtoMediaKeySystem ..> RialtoMediaKeySession : creates
RialtoMediaKeySystem ..> RialtoSessionCallbacks : registers per session
RialtoMediaKeySession --> IMK : reference

note right of AampDrmBridge
	Blocks until the license flow completes
	(runs on the fragment-collector thread).
	Returns the Rialto mks_id that the source
	stamps on every encrypted MediaSegment.
end note

note right of RialtoMediaKeySessionAdapter
	Does not override decrypt(): decryption
	is done in the Rialto server pipeline.
end note

@enduml
