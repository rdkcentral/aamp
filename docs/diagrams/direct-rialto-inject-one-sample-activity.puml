@startuml direct-rialto-inject-one-sample-activity
title AampRialtoMediaSource::injectOneSample (runs on the track's injector thread)
skinparam shadowing false

start
if (BeginInject() false?\n(EOS latched and no request pending)) then (yes)
  :return false (sample ignored);
  stop
endif
repeat
  :Stage 1: WaitForGate(capturedGen)\nblocks while BLOCKED;
  if (generation changed or DROPPED?) then (yes)
    :answer abandoned request (NO_AVAILABLE_SAMPLES);
    :return false;
    stop
  endif
  :Stage 2: WaitForRequest(capturedGen)\nblocks until a request is pending\n(gate re-set to BLOCKED first: restart at stage 1);
  if (generation changed?) then (yes)
    :answer abandoned request;
    :return false;
    stop
  endif
  :createSegment(sample) (outside the lock);
  if (size > UINT32_MAX or annotateEncryption() fails\nor createSegment() null?) then (yes - drop)
    :DropSample(req): answer EOS or NO_AVAILABLE_SAMPLES\nif the request is still owned;
    :return false;
    stop
  endif
  :setCodecData (first sample after attach), setData;
  :addSegment(req, segment);
repeat while (addSegment returned NO_SPACE?) is (yes) not (no)
note right
  NO_SPACE: OnNoSpace() marks bufferFull, closes the batch with
  haveData(OK) if frames were added else NO_AVAILABLE_SAMPLES.
  The SAME sample is retried on the next needData; the injector
  stays active (EOS is not answered meanwhile).
end note
:update firstPtsMs / injectedSpan / acceptedFrames (status OK only);
:Complete(gen, req, morePending, segment);
if (reply?) then (Ok / Eos)
  :haveData(OK or EOS, req);
elseif (Abandoned) then
  :haveData(NO_AVAILABLE_SAMPLES, req);
else (None)
  :batch not complete: no reply yet;
endif
:return true;
stop
@enduml
