@startuml direct-rialto-segment-position-sequence
title Segment position: stage, commit and position reporting
skinparam shadowing false

participant "Control thread" as CTL
participant "AampRialtoSegmentPosition" as POS
participant "IMediaPipeline" as PIPE
participant "Rialto event thread" as EV
participant "Injector thread" as INJ
participant "AAMP position poll" as POLL

== Flush(position, rate, authoritative) ==
CTL -> POS : StageRequested(posNs, rate, authoritative)
CTL -> PIPE : setPosition(posNs)

== A source attaches (first attach, or after Configure) ==
INJ -> POS : StagedPositionNs() (-1 if none)
INJ -> PIPE : setSourcePosition(id, stagedNs, resetTime=true, appliedRate)
opt source is VIDEO
  INJ -> POS : CommitBaseline(max(0, stagedNs))
end

== SEEK_DONE ==
EV -> POS : StagedPositionNs(), StagedRate()
EV -> PIPE : setSourcePosition(video, posNs, resetTime=false, appliedRate)\n(only when appliedRate != 1.0, i.e. trickplay)
EV -> POS : CommitBaseline(posNs)
note right of EV : m_rate = staged rate, Flushing hold released

== GetPositionMilliseconds() ==
POLL -> PIPE : getPosition(queriedNs)
POLL -> POS : BaselineNs()
note right of POLL
  FLUSHING / FLUSHED or PositionPending: report 0.
  Otherwise elapsed = queried - baseline, then
  rate > 0: max(0, elapsed) * rate;  rate < 0: elapsed * rate.
end note
@enduml
