@startuml direct-rialto-layers-component
title direct-rialto: layers and components

package "L0  AAMP core (outside direct-rialto)" {
	[PrivateInstanceAAMP] as CORE
	[AampStreamSinkManager] as MGR
	[StreamAbstractionAAMP /\nAampMp4Demuxer] as SA
	[AampDRMLicenseManager /\nDrmSessionManager] as LIC
	[PlayerCCManager\n(PlayerDirectRialtoCCManager)] as CC
}

package "L1  Sink facade and orchestration" {
	[AampRialtoPlayer\n(StreamSink + IDirectRialtoCC +\nIAampRialtoPipelineEvents)] as ARP
}

package "L2  Policy helpers owned by the player" {
	[PlayerStateMachine] as SM
	[AampRialtoPlaybackController\n(PlayHold bits)] as PC
	[AampRialtoSegmentPosition] as SP
	[AampRialtoPreRollMonitor] as PRM
	[AampRialtoMonitorAV] as MAV
	[AampRialtoProgressTimer] as PT
	[AampRialtoGlibTimer] as GT
}

package "L3  Per-track sources" {
	[AampRialtoMediaSource\n(Video / Audio / Subtitle)] as SRC
	[AampRialtoNeedDataHandshake] as HS
	[AampRialtoTtmlOffset] as TTML
}

package "L4  Adapters to the outside" {
	[PrivateInstanceAAMPNotifiable\n(IStreamSinkNotifiable)] as NOTIF
	[AampDrmBridge\n(IDrmBridge)] as BRIDGE
	[RialtoSessionCreator /\nRialtoMediaKeySystem /\nRialtoMediaKeySession(+Adapter)] as RDRM
}

package "L5  Rialto connection" {
	[AampRialtoPipelineSession] as PS
	[AampRialtoMediaPipelineClient] as CLIENT
	[AampRialtoControlBackend\n(IRialtoControlBackend)] as CB
}

cloud "Rialto client library\n(IMediaPipeline, IMediaKeys, IControl)" as RLIB

MGR --> ARP : new / delete
SA --> ARP : StreamSink API
CORE --> ARP : via sink manager
ARP --> NOTIF : IStreamSinkNotifiable
NOTIF --> CORE : ScheduleAsyncTask
ARP *-- SM
ARP *-- PC
ARP *-- SP
ARP *-- PRM
ARP *-- MAV
ARP *-- PT
PRM *-- GT
MAV *-- GT
PT *-- GT
ARP o-- SRC : 0..3, shared_ptr
SRC *-- HS
SRC *-- TTML : subtitle only
ARP *-- PS
PS *-- CLIENT
PS *-- CB
CLIENT --> ARP : IAampRialtoPipelineEvents
ARP --> BRIDGE : createSession
BRIDGE --> LIC
LIC ..> RDRM : DrmSessionCreator
CC ..> ARP : IDirectRialtoCC\n(track select, CC mute)
PS --> RLIB
SRC --> RLIB : addSegment / haveData
RDRM --> RLIB

@enduml
