@startuml direct-rialto-send-copy-activity
title AampRialtoPlayer::SendCopy decision flow (HLS-TS ES frames, ID3)
skinparam shadowing false

start
:GetPipeline() (shared_ptr kept for the whole call);
:ReportID3Metadata()\nID3 header check on every buffer, handler called if valid;
if (getSource(mediaType) is null?) then (yes)
  :WARN "No source" (DSM-CC/ID3 packets end here);
  :return false;
  stop
endif
if (buffer empty?) then (yes)
  :WARN; return false;
  stop
endif
if (pipeline null?) then (yes)
  :WARN; return false;
  stop
endif
if (source not attached?) then (yes)
  :for every unattached source in the player:\nSetStreamCaps(type, codec = source->format()\nonly, no size / channels / codec data);
  note right
    Muxed HLS-TS has one inject thread, so all
    sources are attached from it now.
  end note
endif
:wrap buffer in shared_ptr;
:MaybeFlushForPendingPosition(mediaType, fpts)\n(no-op unless PositionPending and this is the elected track);
:source->processDataFragment(fpts, fdts, fDuration);
if (source has no demuxer?) then (yes - ES path)
  if (waitForAttach() true?) then (yes)
    :build one AampMediaSample (pts, dts, duration)\ncapture generation, take pending codec data;
    :injectOneSample(morePending=false)\nblocks until Rialto needs data;
  else (no)
    :drop the frame (source not attached / aborted);
  endif
  :return true;
else (no - fMP4 demuxer present)
  :Mp4Demux parse, inject each sample;
endif
:success = result of processDataFragment;
stop
@enduml
