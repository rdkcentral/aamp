@startuml direct-rialto-position-report-activity
title AampRialtoPlayer::GetPositionMilliseconds (segment-relative position)

start
:Called by AAMP core (any thread),\ne.g. MonitorProgress on scheduler thread;
if (state is FLUSHING or FLUSHED?) then (yes)
	:INFO "position not yet valid, reporting 0";
	:return 0;
	stop
endif
if (PlayHold::PositionPending applied?) then (yes)
	:TRACE "positionPending - reporting 0";
	:return 0;
	stop
endif
if (GetPipeline() non-null?) then (no)
	:WARN "pipeline is null";
	:return 0;
	stop
endif
if (pipeline->getPosition(ns)) then (fails)
	:WARN "getPosition() failed";
	:return 0;
	stop
endif
:rawMs = ns / kNsPerMs\nstartMs = BaselineNs() / kNsPerMs\nelapsed = rawMs - startMs\nrate = m_rate;
if (rate > 0?) then (yes)
	:position = max(0, elapsed) * rate;
else (no, reverse)
	:position = elapsed * rate;
endif
:return position;
note right
  Core adds seek_pos_seconds * 1000
  and forces 0 while eSTATE_SEEKING.
end note
stop
@enduml
