@startuml direct-rialto-flush-seek-sequence
title direct-rialto flush / seek (flushable path of AampRialtoPlayer::Flush)

participant "AAMP control thread\n(or injector thread for a\ndeferred flush)" as CT
participant AampRialtoPlayer as P
participant PlayerStateMachine as SM
participant AampRialtoPlaybackController as PC
participant "Media sources\n(video/audio/subtitle)" as SRC
participant "Rialto pipeline" as RP
participant "Rialto event thread" as ET

CT -> P : Flush(position, rate,\nshouldTearDown, authoritative)
P -> P : lock m_flushCallMutex\n(recursive, held to the end of Flush)
P -> SM : waitForFlushComplete(timeout)
note right of SM
  Returns at once unless a previous flush is still in
  FLUSHING.  If SEEK_DONE does not arrive within the
  timeout the previous flush is abandoned: state leaves
  FLUSHING, the staged rate is committed and the
  Flushing hold is released.
end note
P -> PC : AddHold(Flushing)
P -> P : stage position / rate / authority\n(AampRialtoSegmentPosition)
P -> PC : ReleaseHold(PositionPending)

alt state not PLAYING / PAUSED / SOURCES_ATTACHED / FLUSHED
  alt shouldTearDown
    P -> P : StopInternal(true)
  else
    P -> SRC : unblockInjection + gateInjection(false)\n(rate committed, no flush cycle)
  end
  P -> PC : ReleaseHold(Flushing)
  P --> CT : return
else flushable
  P -> SM : onFlush()  [-> FLUSHING]
  P -> P : ArmPreRoll(rate)
  P -> SRC : unblockInjection()\n(generation++, gate DROPPED)
  P -> SRC : gateInjection(true)\n(gate BLOCKED: hold new data)
  alt pipeline present
    P -> RP : setPosition(posNs)
    alt setPosition fails
      P -> SM : onFlushComplete()  [-> FLUSHED]
      P -> PC : ReleaseHold(Flushing)
    end
  else no pipeline
    P -> SM : onFlushComplete()  [-> FLUSHED]
    P -> PC : ReleaseHold(Flushing)
  end
  P --> CT : return (Flush done; seek still in flight)
end

... Rialto completes the seek asynchronously ...

RP -> ET : PlaybackState::SEEK_DONE
ET -> P : HandleSeekDone()
P -> P : apply trickplay / subtitle segment position,\ncommit rate, commit segment baseline
P -> PC : ReleaseHold(Flushing)\n(still FLUSHING, so a Flush() waiting\nin WaitForComplete cannot interleave)
alt play requested and no other hold left
  PC -> P : play action: IssuePlay()
  P -> SRC : gateInjection(false)  (UngateAllSources)
  P -> RP : play()
end
P -> SM : onFlushComplete()  [FLUSHING -> FLUSHED]
SM -> SM : notify_all  (wakes Configure()/Stop()/Flush() waiting)

RP -> ET : PlaybackState::PLAYING / PAUSED
ET -> SM : onPlaybackStarted / onPlaybackPaused\n[FLUSHED -> PLAYING / PAUSED]

== Failure while flushing ==
RP -> ET : PlaybackState::FAILURE
ET -> P : HandlePlaybackFailure()
P -> SM : onError()  [-> ERROR]
SM -> SM : notify_all  (waiters wake, no timeout needed)
@enduml
