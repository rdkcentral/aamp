@startuml direct-rialto-sources-class
title direct-rialto: per-track media source hierarchy

class AampRialtoMediaSource <<abstract>> {
	-m_handshake : AampRialtoNeedDataHandshake
	-m_sourceId : atomic<int32_t>
	-m_mksId : atomic<int32_t>
	-m_demuxer : unique_ptr<Mp4Demux>
	-m_pendingCodecData : shared_ptr<CodecData>
	-m_firstPtsMs / m_acceptedFrames ...
	+attachOrUpdate(pipeline, codecInfo, drmBridge, ...)
	+processInitFragment(buffer)
	+processDataFragment(...)
	+injectSingleSample(...)
	+injectOneSample(...)
	+handleNeedData() / handleCancelNeedData()
	+gateInjection() / unblockInjection()
	+signalEos() / reset()
	+{abstract} mediaType()
	#{abstract} mapCodecToMime()
	#{abstract} createRialtoSource()
	#{abstract} updateCachedMetadata()
	#{abstract} createSegment()
}

class AampRialtoVideoSource {
	-m_width, m_height
	H.264 / HEVC
}
class AampRialtoAudioSource {
	-m_sampleRate, m_channels
	AAC / AC-3 / EAC-3 / AC-4
}
class AampRialtoSubtitleSource {
	-m_ttmlOffset : AampRialtoTtmlOffset
	-m_applyTextTransform
	TTML / WebVTT / TTML-in-MP4 / inband CC
}
class AampRialtoNeedDataHandshake {
	+State (mutex, cv, generation, gateMode ...)
	+Reset() / Unblock() / SetGate()
	+OnNeedData() / OnCancelNeedData()
	+BeginInject() / Complete()
	+SignalEos()
}
class AampRialtoTtmlOffset {
	+Refine(doc, pts, dur, aampOffset)
	+Reset()
}
class Mp4Demux <<mp4demux/>>
class "SourceCreator\nstd::function<unique_ptr<Source>(AampMediaType)>" as SC
class "makeDefaultSourceCreator()" as MDSC <<AampRialtoSourceCreators.cpp>>

AampRialtoMediaSource <|-- AampRialtoVideoSource
AampRialtoMediaSource <|-- AampRialtoAudioSource
AampRialtoMediaSource <|-- AampRialtoSubtitleSource
AampRialtoMediaSource *-- AampRialtoNeedDataHandshake
AampRialtoMediaSource *-- "0..1" Mp4Demux
AampRialtoSubtitleSource *-- AampRialtoTtmlOffset
MDSC ..> SC : returns
SC ..> AampRialtoVideoSource : creates
SC ..> AampRialtoAudioSource : creates
SC ..> AampRialtoSubtitleSource : creates

note bottom of AampRialtoMediaSource
	Template Method: the base class owns pacing,
	DRM annotation and the needData/haveData
	protocol; subclasses supply codec mapping and
	segment construction.
end note

@enduml
