@startuml direct-rialto-system-context-component
title direct-rialto: system context (two ways AAMP can reach Rialto)

package "AAMP process (libaamp.so)" {
	[Application / aamp-cli /\nJS bindings] as APP
	[PrivateInstanceAAMP\n(player core)] as CORE
	[StreamAbstractionAAMP\n(fragment collectors, injectors)] as SA
	[AampStreamSinkManager\n(sink factory)] as MGR
	interface "StreamSink" as SS
	package "direct-rialto/" {
		[AampRialtoPlayer] as ARP
	}
	package "GStreamer path" {
		[AAMPGstPlayer +\nInterfacePlayerRDK +\nrialto-gstreamer sinks] as GST
	}
	[Mp4Demux / AampMp4Demuxer] as DEMUX
	[DRM license manager\n(AampDRMLicenseManager)] as DRM
}

package "Rialto client libraries (libRialtoClient.so)" {
	[IMediaPipeline\nIMediaKeys\nIControl] as RCLIENT
}

node "Rialto server process (platform)" {
	[RialtoServer] as RSRV
	[HW decoders / renderers] as HW
	[CDM (Widevine, PlayReady ...)] as CDM
}

APP --> CORE : tune / seek / rate
CORE --> SA : manifests, fragments
SA --> DEMUX : fMP4 fragments\n(useMp4Demux)
SA --> SS : SendCopy / SendTransfer /\nSendSample / Flush ...
MGR ..> SS : creates one\n(useDirectRialto selects)
SS <|.. ARP
SS <|.. GST
CORE --> MGR : GetStreamSink()
ARP --> CORE : notifications\n(async tasks)
ARP --> RCLIENT : IPC calls\n(attachSource, addSegment, play ...)
RCLIENT --> ARP : events\n(needData, playback state)
ARP --> DRM : AampDrmBridge\n(createSession)
DRM --> RCLIENT : IMediaKeys
GST ..> RCLIENT : via rialtomse*sink\n(useRialtoSink)
RCLIENT --> RSRV : IPC (RIALTO_SOCKET_PATH)
RSRV --> HW
RSRV --> CDM

@enduml
