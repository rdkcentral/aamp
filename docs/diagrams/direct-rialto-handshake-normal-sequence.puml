@startuml direct-rialto-handshake-normal-sequence
title Handshake: needData arrives, then the injector adds segments
skinparam shadowing false

participant "Rialto event thread" as EV
participant "AampRialtoMediaSource" as SRC
participant "NeedDataHandshake\n(mutex State::mu)" as HS
participant "Injector thread\n(blocked in WaitForRequest)" as INJ
participant "IMediaPipeline" as PIPE

EV -> SRC : handleNeedData(frameCount=N, req=7)
SRC -> HS : OnNeedData(N, 7)
note right of HS
  gateMode == NONE:
  hasPending = true
  pendingRequestId = 7
  pendingFrameCount = max(N, 1)
end note
HS --> SRC : {superseded none, rejected false, eos none}
SRC -> HS : WakeWaiters()
HS -> INJ : cv.notify_all()
INJ -> HS : WaitForRequest(gen) returns Proceed, req=7
loop for each sample until the batch is complete
  INJ -> INJ : createSegment(), annotateEncryption()
  INJ -> PIPE : addSegment(7, segment)
  PIPE --> INJ : OK
  INJ -> HS : Complete(gen, 7, morePending, segment)
  HS --> INJ : Reply::None (count < N and more samples pending)
end
note over INJ, HS
  Last sample: count reaches N, or morePending == false
  (end of the fragment) -> Reply::Ok. hasPending cleared,
  BatchSummary snapshotted, injectorActive = false.
end note
INJ -> PIPE : haveData(OK, 7)
note over PIPE : Rialto issues the next needData
@enduml
