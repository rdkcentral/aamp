@startuml direct-rialto-flush-rapid-second-seek-sequence
title Rapid second seek: Flush B arrives while Flush A waits for SEEK_DONE

participant "AAMP control\nthread" as CT
participant "AampRialtoPlayer" as P
participant "PlaybackController\n(play lock)" as PC
participant "PlayerStateMachine" as SM
participant "Rialto" as R
participant "Rialto event\nthread" as EV

note over P, SM : Flush A has returned: state FLUSHING, Flushing hold set,\nA's position and rate staged
CT -> P : Flush B(posB, rateB)
P -> P : lock m_flushCallMutex (free)
P -> SM : waitForFlushComplete()
activate SM
note right of SM : B blocks; nothing of B\nis staged yet

R -> EV : SEEK_DONE (A)
EV -> P : HandleSeekDone()
P -> P : commit A's rate and baseline
P -> PC : ReleaseHold(Flushing)
alt play request pending, no other hold
  PC -> R : ungate, play()  (A's position)
end
P -> SM : onFlushComplete() -> FLUSHED
SM --> P : wake B
deactivate SM

P -> PC : AddHold(Flushing)
note right of PC : waits on the play lock until\nA's play() has finished, so it\ncannot ungate after B gates
P -> P : stage posB, rateB
P -> SM : FLUSHED is flushable: onFlush() -> FLUSHING
P -> P : ArmPreRoll, abort and re-gate sources
P -> R : setPosition(posB)

R -> EV : PLAYING (late, for A)
EV -> SM : onPlaybackStarted()
note right of SM : no FLUSHING transition:\nWARN, stays FLUSHING

R -> EV : SEEK_DONE (B)
EV -> P : HandleSeekDone() as normal

note over CT, EV : If A's SEEK_DONE never arrives, B waits 5000 ms, abandons A and continues from FLUSHED.
@enduml
