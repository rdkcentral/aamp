@startuml direct-rialto-drm-license-sequence
title direct-rialto: DRM license acquisition (pre-fetcher acquires, injector reuses)

participant "PreFetchThread\n(AampLicensePreFetcher)" as PF
participant "Injector thread\n(AampRialtoMediaSource)" as INJ
participant "AampDrmBridge" as BR
participant "AampDRMLicenseManager +\nDrmSessionManager" as LM
participant "RialtoMediaKeySessionAdapter" as AD
participant "RialtoMediaKeySystem +\nMediaKeysClient" as SYS
participant "Rialto IMediaKeys\n(IPC to server)" as IMK
participant "rialto-media-keys-events\nthread" as EVT
participant "License server" as LS

PF -> LM : createDrmSession(helper)\nlock mDrmSessionLock
LM -> AD ** : creator: new adapter +\nRialtoMediaKeySystem(createMediaKeys)
LM -> AD : generateDRMSession(initData)\n(slot sessionMutex)
AD -> SYS : createSession("cenc", initData, callbacks)
SYS -> IMK : createKeySession(TEMPORARY) -> keySessionId (mksId)
SYS -> SYS : register callbacks + session\nin client maps (before the request)
SYS -> IMK : generateRequest(CENC, initData)
IMK --> EVT : license request event
EVT -> SYS : onLicenseRequest (CallbackScope)
SYS -> AD : onChallenge: store challenge,\nnotify m_challengeReady
LM -> AD : generateKeyRequest(url, 5000 ms)
note right of AD : blocks on m_challengeReady\n(returns at once if already received)
AD --> LM : challenge, KEY_PENDING
LM -> LS : HTTP POST challenge\n(drmNetworkTimeout 5 s, up to 2 attempts)
LS --> LM : license
LM -> AD : processDRMKey(license, 5000 ms)
AD -> IMK : updateSession(mksId, license)
IMK --> EVT : key statuses event
EVT -> SYS : onKeyStatusesChanged: update key cache,\nthen onKeyUpdate x N, onKeysUpdated
SYS -> AD : notify m_keyStatusReady
AD --> LM : 0 + KEY_READY (any key USABLE)
LM --> PF : DrmSession*; unlock mDrmSessionLock

INJ -> BR : createSession(systemId, pssh, type)\n(holds m_attachMutex)
BR -> LM : createDrmSession(...)\nwaits for mDrmSessionLock
LM -> LM : getDrmSession: same key ID in slot,\nKEY_READY (or waitForState up to 5 s)
LM --> BR : existing DrmSession*
BR -> AD : getMediaKeySessionId()
BR --> INJ : mksId (or -1)
@enduml
