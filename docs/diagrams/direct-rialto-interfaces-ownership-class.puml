@startuml direct-rialto-interfaces-ownership-class
title direct-rialto: notification / backend interfaces and ownership of the Rialto objects

interface IStreamSinkNotifiable {
	+NotifyFirstFrameReceived()
	+NotifyFirstBufferProcessed()
	+NotifyEOSReached()
	+MonitorProgress()
	+NotifyBufferUnderflow()
	+NotifyPlaybackError()
	+SendMonitorAvEvent() ...
	+GetState() / GetProgressReportIntervalSeconds()
}
class PrivateInstanceAAMPNotifiable <<final>> {
	-m_aamp : atomic<PrivateInstanceAAMP*>
	+ChangeAamp()
}
interface IRialtoControlBackend {
	+waitForRunning(timeoutMs) : bool
}
class AampRialtoControlBackend <<final>> {
	-m_state : shared_ptr<SharedState>
	-m_controlClient : shared_ptr<ControlClient>
	-m_control : shared_ptr<IControl>
}
interface IAampRialtoPipelineEvents
class AampRialtoMediaPipelineClient {
	-m_sink : IAampRialtoPipelineEvents* (not owned)
	+SetEventSink()
}
interface "firebolt::rialto::IMediaPipelineClient" as IMPC <<Rialto>>
interface "firebolt::rialto::IMediaPipeline" as IMP <<Rialto>>
interface "firebolt::rialto::IMediaPipelineFactory" as IMPF <<Rialto>>
interface "IMediaPipelineCapabilities" as IMPCap <<Rialto>>

class AampRialtoPipelineSession {
	-m_logHandler : shared_ptr<LogHandler>
	-m_factory : shared_ptr<IMediaPipelineFactory>
	-m_capabilities : unique_ptr
	-m_controlBackend : unique_ptr<IRialtoControlBackend>
	-m_client : shared_ptr<AampRialtoMediaPipelineClient>
	-m_pipeline : shared_ptr<IMediaPipeline>
	+CreateAndLoad(events)
	+ReleaseControlBackend()
}
class AampRialtoPlayer
class AampRialtoMonitorAV

IStreamSinkNotifiable <|.. PrivateInstanceAAMPNotifiable
IRialtoControlBackend <|.. AampRialtoControlBackend
IMPC <|.. AampRialtoMediaPipelineClient

AampRialtoPlayer *-- AampRialtoPipelineSession
AampRialtoPlayer --> IStreamSinkNotifiable : raw, not owned
AampRialtoPlayer *-- PrivateInstanceAAMPNotifiable : production only
AampRialtoPipelineSession *-- IRialtoControlBackend : unique_ptr,\nlazily created
AampRialtoPipelineSession *-- AampRialtoMediaPipelineClient : shared_ptr
AampRialtoPipelineSession *-- IMP : shared_ptr (snapshots\nhanded out)
AampRialtoPipelineSession *-- IMPF
AampRialtoPipelineSession *-- IMPCap
IMP ..> IMPC : weak_ptr to client
AampRialtoMediaPipelineClient ..> IAampRialtoPipelineEvents : calls without\nits lock held
IAampRialtoPipelineEvents <|.. AampRialtoPlayer : private
AampRialtoMonitorAV o-- IMP : shared_ptr
AampRialtoMonitorAV --> IStreamSinkNotifiable : raw, not owned

note bottom of AampRialtoPipelineSession
	Destruction order: pipeline released first,
	then the client's event sink is cleared.
	The last pipeline release joins Rialto's
	event thread, so no event can run on a
	destroyed player.
end note

@enduml
