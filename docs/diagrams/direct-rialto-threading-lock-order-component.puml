@startuml direct-rialto-threading-lock-order-component
title direct-rialto lock order (arrow = held while taking)

rectangle "AAMP mLock / mStreamLock\n(held by AAMP core)" as AAMP
rectangle "m_flushCallMutex\n(recursive)" as FLUSH
rectangle "m_attachMutex" as ATTACH
rectangle "m_monitorMutex" as MON
rectangle "GLib timer locks\n(progress, pre-roll,\nMonitorAV x2; recursive)" as TIMER
rectangle "controller play lock\nm_playMutex (recursive)" as PLAY
rectangle "DRM licence fetch\n(AampDrmBridge + DRM locks)" as DRM
rectangle "Rialto IPC\n(play, pause, stop, setPosition,\nattachSource, haveData, ...)" as IPC

package "leaf locks" {
	rectangle "PlayerStateMachine::m_mutex" as SM
	rectangle "controller m_mutex" as CM
	rectangle "handshake State::mu\n(per source)" as HS
	rectangle "m_sourcesMutex,\nm_pipelineMutex" as SRC
	rectangle "m_drmBridgeMutex,\nm_pendingAttachMutex,\nm_pendingProtectionMutex,\nm_codecDataMutex" as ATTL
	rectangle "m_ptsCheckMutex, m_videoRectangleMutex,\nm_id3HandlerMutex, pre-roll m_mutex,\nprogress m_mutex, client m_sinkMutex" as OTHER
}

AAMP --> FLUSH
AAMP --> PLAY : Discontinuity
FLUSH --> TIMER : Stop() waits for tick
FLUSH --> MON
FLUSH --> PLAY
FLUSH --> SM : flush wait
FLUSH --> HS
FLUSH ..> IPC
ATTACH --> TIMER : pre-roll Start()
ATTACH --> PLAY
ATTACH --> SM
ATTACH --> ATTL
ATTACH --> HS
ATTACH ..> DRM
ATTACH ..> IPC
ATTACH --> AAMP : ResumeTrackDownloads\n(subtitle; AAMP never\nholds mLock here)
MON --> TIMER : MonitorAV start()
TIMER --> PLAY : pre-roll completion
TIMER --> SRC
TIMER --> HS
PLAY --> CM
PLAY --> HS
PLAY --> SRC
PLAY ..> IPC
@enduml
