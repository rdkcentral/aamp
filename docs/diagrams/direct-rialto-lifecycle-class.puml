@startuml direct-rialto-lifecycle-class
title Lifecycle collaborators (data-path and DRM classes omitted)

class AampRialtoPlayer <<StreamSink>> {
  +Configure()
  +Stream()
  +Pause(bool)
  +Flush(...)
  +Stop(keepLastFrame)
  -IssuePlay()
  -StartPreRoll()
  -CheckAllSourcesAttached()
  -HandlePlaybackStarted()
  -HandleSeekDone()
  -HandlePlaybackFailure()
}
interface IAampRialtoPipelineEvents {
  +OnPlaybackState()
  +OnNeedMediaData()
  +OnPlaybackError()
  +OnBufferUnderflow()
}
class PlayerStateMachine {
  +onPipelineLoaded() ... onStop()
  +currentState()
  +waitForFlushComplete(timeout)
}
class AampRialtoPlaybackController {
  +RequestPlay() / CancelPlayRequest()
  +AddHold(PlayHold) / ReleaseHold(PlayHold)
  +Reset()
  -m_holds : atomic bitmask
  -m_playMutex : recursive
}
class AampRialtoPreRollMonitor {
  +Start() / Stop()
  -Poll() on GLib tick
}
class AampRialtoPipelineSession {
  +CreateAndLoad()
  +GetPipeline() / SetPipeline()
  +ReleaseControlBackend()
}
interface IRialtoControlBackend {
  +waitForRunning(timeoutMs)
}
class AampRialtoControlBackend
class AampRialtoMediaPipelineClient <<IMediaPipelineClient>>
interface IStreamSinkNotifiable
class PrivateInstanceAAMPNotifiable

AampRialtoPlayer ..|> IAampRialtoPipelineEvents : private
AampRialtoPlayer *-- PlayerStateMachine
AampRialtoPlayer *-- AampRialtoPlaybackController
AampRialtoPlayer *-- AampRialtoPreRollMonitor
AampRialtoPlayer *-- AampRialtoPipelineSession
AampRialtoPlayer --> IStreamSinkNotifiable : notifications
PrivateInstanceAAMPNotifiable ..|> IStreamSinkNotifiable
AampRialtoPipelineSession *-- IRialtoControlBackend : unique_ptr,\nlazy
AampRialtoControlBackend ..|> IRialtoControlBackend
AampRialtoPipelineSession *-- AampRialtoMediaPipelineClient : shared_ptr
AampRialtoMediaPipelineClient --> IAampRialtoPipelineEvents : forwards Rialto\nevents (event thread)
AampRialtoPlaybackController ..> AampRialtoPlayer : callbacks:\nIssuePlay / StartPreRoll
AampRialtoPreRollMonitor ..> AampRialtoPlaybackController : ReleaseHold\n(PreRollIncomplete)
@enduml
