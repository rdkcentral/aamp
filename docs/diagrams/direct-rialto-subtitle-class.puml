@startuml direct-rialto-subtitle-class
title Subtitle and closed-caption classes

abstract class AampRialtoMediaSource {
  +attachOrUpdate()
  +processInitFragment()
  +processDataFragment()
  #mapCodecToMime()
  #createRialtoSource()
  #createSegment(sample)
  #updateCachedMetadata()
}
class AampRialtoSubtitleSource {
  +processInitFragment()
  +processDataFragment()
  +isInbandCC() : format() == FORMAT_INVALID
  #mapCodecToMime() : text/ttml, text/vtt, text/cc
  #createRialtoSource() : MediaSourceSubtitle(mime, "CC1")
  #createSegment() : SUBTITLE segment + setDisplayOffset
  -refineDisplayOffset(sample)
  -m_applyTextTransform : bool
}
class AampRialtoTtmlOffset {
  +Reset()
  +Refine(data, size, ptsMs, durationMs, aampOffsetMs)
  +{static} ParseTimeToMs()
  +{static} FindFirstBeginMs()
  -m_contentType : UNKNOWN / PASSTHROUGH / LINEAR_OFFSET
  -m_linearOffsetMs
}
interface IDirectRialtoCC {
  +setTextTrackIdentifier(id)
  +setCCMute(muted)
}
class AampRialtoPlayer {
  +SetSubtitleMute()
  +SetSubtitlePtsOffset() : no-op
  +SignalSubtitleClock()
  -CreateSubtitleSource()
  -ApplySubtitleSegmentPosition()
  -GetCCHandle()
}
class PlayerDirectRialtoCCManager <<middleware>> {
  +Initialize(handle)
  +SetTrack(track)
  +StartRendering() / StopRendering()
  +InvalidateHandle(handle)
}
class PlayerCCManager <<middleware singleton>>

AampRialtoMediaSource <|-- AampRialtoSubtitleSource
AampRialtoSubtitleSource *-- AampRialtoTtmlOffset
AampRialtoPlayer ..|> IDirectRialtoCC
AampRialtoPlayer o-- AampRialtoSubtitleSource : subtitle slot
PlayerCCManager ..> PlayerDirectRialtoCCManager : creates when\nSetRialto(true, true)
PlayerDirectRialtoCCManager --> IDirectRialtoCC : stored control\n(from GetCCHandle)
@enduml
