@startuml direct-rialto-preroll-activity
title Pre-roll: from arming PreRollIncomplete to play()

start
:ArmPreRoll(rate)\n(Configure/BeginNewSession or flushable Flush);
:stop pre-roll monitor;
if (gstBufferAndPlay set and rate == 1?) then (yes)
  :AddHold(PreRollIncomplete);
else (no)
  :ReleaseHold(PreRollIncomplete);
  stop
endif
:wait until a play request is pending and\nPreRollIncomplete is the ONLY hold;
:controller: ++episode;\nStartPreRoll(reason, episode)\n(play lock released one level);
partition "RunIfPreRollCurrent(episode) - under play lock" {
  if (episode still current?) then (no)
    :ignore (stale: Flush/Configure/Stop ended it);
    stop
  endif
  if (pipeline and attached primary source\n(video, else audio)?) then (no)
    :ReleaseHold(PreRollIncomplete) ("skipped");
    stop
  endif
  :pipeline->pause();
  :UngateAllSources("PreRoll");
  :m_preRollEpisode = episode;
}
:m_preRollMonitor->Start(probe)\n(outside the play lock);
:GLib ticks: Poll() every 10 ms;
:complete: frames >= 4, buffer full,\nEOS, or 1000 ms timeout;
partition "RunIfPreRollCurrent(m_preRollEpisode)" {
  if (episode still current?) then (yes)
    :ReleaseHold(PreRollIncomplete);
    :no holds left: IssuePlay()\n(ungate, play()) on the GLib thread;
  else (no)
    :completion ignored and logged;
  endif
}
stop
@enduml
