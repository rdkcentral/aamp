+
+static bool DispatchToLoggerCallbacks(MW_LogLevel level, const char* function, int line,
+                                      const char* format, va_list args)
+{
+	LoggerCallbackLease lease;
+	const PlayerLoggerCallbacks& callbacks = lease.Get();
+	if (!callbacks.log)
+	{
+		return false;
+	}
+	try
+	{
+		if (callbacks.isEnabled && !callbacks.isEnabled(callbacks.context, level))
+		{
+			return true;
+		}
+
+		va_list measureArgs;
+		va_copy(measureArgs, args);
+		int messageBytes = vsnprintf(NULL, 0, format, measureArgs);
+		va_end(measureArgs);
+		if (messageBytes < 0)
+		{
+			return true;
+		}
+
+		std::vector<char> message(static_cast<size_t>(messageBytes) + 1);
+		vsnprintf(message.data(), message.size(), format, args);
+		callbacks.log(callbacks.context, level, "PLAYER_IF", function, line, message.data());
+	}
+	catch (...)
+	{
+	}
+	return true;
+}
 /**
  * @brief Print logs to console / log file
  */
 void logprintf(MW_LogLevel logLevelIndex, const char* func, int line, const char *format, ...)
 {
+	va_list callbackArgs;
+	va_start(callbackArgs, format);
+	bool callbackHandled = DispatchToLoggerCallbacks(logLevelIndex, func, line, format, callbackArgs);
+	va_end(callbackArgs);
+	if (callbackHandled)
+	{
+		return;
+	}
+	if (logLevelIndex < PlayerLogManager::mwLoglevel)
+	{
+		return;
+	}
+
 	// Increment log counter for each log line, wrap at 1000 for consistent 3-digit formatting
 	uint32_t logSeqNum = gMwLogCounter.fetch_add(1, std::memory_order_relaxed) % 1000;
 	
