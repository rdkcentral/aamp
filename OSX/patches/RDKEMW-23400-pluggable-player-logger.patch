+static std::mutex gLoggerCallbacksMutex;
+static std::condition_variable gLoggerCallbacksCondition;
+static PlayerLoggerCallbacks gLoggerCallbacks = { sizeof(PlayerLoggerCallbacks), NULL, NULL, NULL };
+static size_t gActiveLoggerCallbacks = 0;
+
+class LoggerCallbackLease
+{
+public:
+	LoggerCallbackLease()
+	{
+		std::lock_guard<std::mutex> lock(gLoggerCallbacksMutex);
+		mCallbacks = gLoggerCallbacks;
+		if (mCallbacks.log)
+		{
+			++gActiveLoggerCallbacks;
+		}
+	}
+
+	~LoggerCallbackLease()
+	{
+		if (mCallbacks.log)
+		{
+			std::lock_guard<std::mutex> lock(gLoggerCallbacksMutex);
+			if (--gActiveLoggerCallbacks == 0)
+			{
+				gLoggerCallbacksCondition.notify_all();
+			}
+		}
+	}
+
+	const PlayerLoggerCallbacks& Get() const { return mCallbacks; }
+
+private:
+	PlayerLoggerCallbacks mCallbacks;
+};
+
+bool PlayerLogManager::SetLoggerCallbacks(const PlayerLoggerCallbacks* callbacks)
+{
+	if (!callbacks || callbacks->structSize < sizeof(PlayerLoggerCallbacks) || !callbacks->log)
+	{
+		return false;
+	}
+	std::lock_guard<std::mutex> lock(gLoggerCallbacksMutex);
+	gLoggerCallbacks = *callbacks;
+	return true;
+}
+
+void PlayerLogManager::ResetLoggerCallbacks()
+{
+	std::unique_lock<std::mutex> lock(gLoggerCallbacksMutex);
+	gLoggerCallbacks = { sizeof(PlayerLoggerCallbacks), NULL, NULL, NULL };
+	gLoggerCallbacksCondition.wait(lock, [] { return gActiveLoggerCallbacks == 0; });
+}
+
+bool PlayerLogManager::HasLoggerCallbacks()
+{
+	std::lock_guard<std::mutex> lock(gLoggerCallbacksMutex);
+	return gLoggerCallbacks.log != NULL;
+}
+
+bool PlayerLogManager::IsLogLevelEnabled(MW_LogLevel level)
+{
+	LoggerCallbackLease lease;
+	const PlayerLoggerCallbacks& callbacks = lease.Get();
+	if (!callbacks.log)
+	{
+		return level >= mwLoglevel;
+	}
+	try
+	{
+		return !callbacks.isEnabled || callbacks.isEnabled(callbacks.context, level);
+	}
+	catch (...)
+	{
+		return false;
+	}
+}
+
